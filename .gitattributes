# Shell scripts must keep LF endings or bash in Linux/WSL will fail on "\r".
*.sh    text eol=lf
*.ps1   text eol=crlf
# Copied into the Linux container / host, so they must stay LF too.
docker/*  text eol=lf
host/*    text eol=lf
# The SDK Manager docker images are ~500 MB each; store them with Git LFS.
images/*.tar*  filter=lfs diff=lfs merge=lfs -text
images/* filter=lfs diff=lfs merge=lfs -text
